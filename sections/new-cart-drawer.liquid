{{ 'new-cart-drawer.css' | asset_url | stylesheet_tag }}
<script src={{ "product-form.js" |  asset_url }} defer="defer"></script>
<script src={{ 'new-cart-drawer.js' |  asset_url }} defer="defer"></script>
<section class="cart-drawer-la">
  <div class="cart-drawer-wrapper-la">
    <div class="cart-drawer-box">
      <header class="cart-drawer-header">
        <h2>{{ 'sections.cart.title' | t }}</h2>

        <div class="cart-drawer-header-right">
          <span class="cart-drawer-header-right-items">{{ cart.item_count }} items</span>
          <button class="cart-drawer-close" type="button">{% render 'icon_x' %}</button>
        </div>
      </header>

      {% form 'cart', cart, class: 'cart-drawer-form' %}
        {% if cart.item_count == 0 %}
          <p class="cart-drawer-empty">{{ 'sections.cart.empty' | t }}</p>
        {% else %}
          <div class="cart-drawer-items">
            {% for item in cart.items %}
              <div class="cart-drawer-item" data-line-key="{{ item.id }}">
                <div class="cart-drawer-item-image">
                  <img src="{{ item.image | image_url: width:200 }}" width="200" height="200" alt="{{ item.image.alt }}">
                </div>

                <div class="cart-drawer-item-info">
                  <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  <span>{{ item.variant.title }}</span>
                  
                  <div class="cart-drawer-quantity">
                    <button class="cart-qty-minus" type="button">{% render 'icon-minus-la' %}</button>
                    <input type="text" class="cart-qty-input" readonly value="{{ item.quantity }}">
                    <button class="cart-qty-plus" type="button">{% render 'icon-plus-la' %}</button>
                  </div>

                  <span class="cart-drawer-item-price">{{ item.final_line_price | money }}</span>
                </div>

                <button class="cart-remove-btn" data-remove-key="{{ item.key }}">
                  {% render 'icon_x' %}
                </button>
              </div>
            {% endfor %}
          </div>

          <footer class="cart-drawer-footer">
            {% if cart.total_discounts > 0 %}
              <div class="cart-drawer-footer-row">
                <h3>Discounts</h3>
                <span>{{ cart.total_discounts | money }}</span>
              </div>
            {% endif %}
            <div class="cart-drawer-footer-row">
              <h3>{{ 'customer.order.subtotal' | t }}</h3>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <button type="submit" name="checkout" class="cart-drawer-button">Checkout</button>
          </footer>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>



{% schema %}
{
  "name": "Cart Drawer",
  "class": "cart-drawer-section",
  "settings": [],
  "presets": [
    {
      "name": "Cart Drawer"
    }
  ]
}
{% endschema %}
